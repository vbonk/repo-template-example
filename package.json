{
  "name": "task-api",
  "version": "0.1.1",
  "description": "Task-management REST API with zero runtime dependencies \u2014 the living example for vbonk/repo-template v2.0.0",
  "type": "module",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "api",
    "rest",
    "tasks",
    "typescript",
    "repo-template"
  ],
  "author": "Anthony Velte (@vbonk)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vbonk/repo-template-example.git"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@types/node": "^22.17.0",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.33.0",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.39.0",
    "vitest": "^3.2.4"
  }
}
